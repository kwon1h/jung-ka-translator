<Window x:Class="GameOverlayTranslator.App.ModuleTestersWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="모듈 테스터" Height="760" Width="980" MinHeight="620" MinWidth="780"
        Background="#F4F3EE">
    <Grid Margin="18">
        <TabControl>
            <TabItem Header="창 열거">
                <Grid Margin="14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Button Width="120" HorizontalAlignment="Left" Content="창 목록 갱신" Click="RefreshTesterWindows" />
                    <DataGrid x:Name="WindowTesterGrid" Grid.Row="1" Margin="0,12,0,12" AutoGenerateColumns="False"
                              IsReadOnly="True" SelectionMode="Single">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="제목" Binding="{Binding Title}" Width="*" />
                            <DataGridTextColumn Header="프로세스" Binding="{Binding ProcessName}" Width="180" />
                            <DataGridTextColumn Header="핸들" Binding="{Binding Handle}" Width="140" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock x:Name="WindowTesterStatus" Grid.Row="2" Text="대기" TextWrapping="Wrap" />
                </Grid>
            </TabItem>
            <TabItem Header="캡처">
                <Grid Margin="14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Width="120" Margin="10,0,0,0" Content="전체 창 캡처" Click="CaptureSelectedWindow" />
                        <ComboBox x:Name="CaptureWindowComboBox" MinHeight="32" />
                    </DockPanel>
                    <Border Grid.Row="1" Margin="0,12" Background="#172121" BorderBrush="#C7C4B8" BorderThickness="1">
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                            <Image x:Name="CapturePreviewImage" Stretch="None" />
                        </ScrollViewer>
                    </Border>
                    <TextBlock x:Name="CaptureTesterStatus" Grid.Row="2" Text="선택한 창의 보이는 화면 영역을 캡처합니다." TextWrapping="Wrap" />
                </Grid>
            </TabItem>
            <TabItem Header="OCR">
                <Grid Margin="14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Width="130" Margin="10,0,0,0" Content="이미지 OCR" Click="RunImageOcr" />
                        <Button DockPanel.Dock="Right" Width="130" Margin="10,0,0,0" Content="이미지 열기" Click="LoadOcrImage" />
                        <ComboBox x:Name="OcrTesterLanguageComboBox" MinHeight="32" Width="180" />
                    </DockPanel>
                    <Grid Grid.Row="1" Margin="0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Background="#172121" BorderBrush="#C7C4B8" BorderThickness="1">
                            <Viewbox Stretch="Uniform">
                                <Image x:Name="OcrTesterImage" Stretch="None" />
                            </Viewbox>
                        </Border>
                        <TextBox x:Name="OcrTesterResult" Grid.Column="2" FontSize="18" TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto" AcceptsReturn="True" IsReadOnly="True" />
                    </Grid>
                    <TextBlock x:Name="OcrTesterStatus" Grid.Row="2" Text="PNG, JPEG 이미지를 열어 Windows OCR만 확인합니다." TextWrapping="Wrap" />
                </Grid>
            </TabItem>
            <TabItem Header="DeepL 번역">
                <Grid Margin="14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Width="110" Margin="10,0,0,0" Content="번역 실행" Click="RunTranslation" />
                        <ComboBox x:Name="TranslationTesterTargetComboBox" DockPanel.Dock="Right" Width="170" MinHeight="32" />
                        <TextBlock VerticalAlignment="Center" Text="메인 창 API 키 입력값을 사용합니다." />
                    </DockPanel>
                    <Grid Grid.Row="1" Margin="0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="TranslationTesterSource" Text="テスト翻訳です。" FontSize="18" TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto" AcceptsReturn="True" />
                        <TextBox x:Name="TranslationTesterResult" Grid.Column="2" FontSize="18" TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto" AcceptsReturn="True" IsReadOnly="True" />
                    </Grid>
                    <TextBlock x:Name="TranslationTesterStatus" Grid.Row="2" Text="DeepL Free 번역 어댑터만 호출합니다." TextWrapping="Wrap" />
                </Grid>
            </TabItem>
            <TabItem Header="세션 루프">
                <Grid Margin="14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal">
                        <Button Width="150" Content="가짜 세션 실행" Click="RunFakeSession" />
                        <TextBlock x:Name="SessionTesterCounters" Margin="14,5,0,0" Text="대기" />
                    </StackPanel>
                    <TextBox x:Name="SessionTesterLog" Grid.Row="1" Margin="0,12" TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto" AcceptsReturn="True" IsReadOnly="True" />
                    <TextBlock Grid.Row="2" Text="중복 OCR 텍스트를 번역 서비스로 다시 보내지 않는지 가짜 캡처/OCR/번역기로 확인합니다." TextWrapping="Wrap" />
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
