<Window x:Class="GameOverlayTranslator.App.ResultWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="채팅 번역" Height="360" Width="620" MinHeight="220" MinWidth="420" Background="#131B1A">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,10">
            <CheckBox x:Name="ShowSourceSpeakerToggle" DockPanel.Dock="Right" Content="원문 유저명 표시"
                      IsChecked="True" Foreground="#F7F6F0" VerticalAlignment="Center" />
            <StackPanel x:Name="OpacityPanel" DockPanel.Dock="Right" Orientation="Horizontal" Margin="0,0,14,0"
                        Visibility="Collapsed">
                <TextBlock Text="불투명도" Foreground="#F7F6F0" VerticalAlignment="Center" Margin="0,0,6,0" />
                <Slider x:Name="OpacitySlider" Width="100" Minimum="0.35" Maximum="1" Value="0.86"
                        ValueChanged="OpacityChanged" VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock x:Name="ResultStatusText" Text="대기" Foreground="#B7C6C2" VerticalAlignment="Center" />
        </DockPanel>
        <Border x:Name="ChatPanel" Grid.Row="1" Background="#282B59" BorderBrush="#52645F" BorderThickness="1" Padding="12">
            <ScrollViewer x:Name="ChatScrollViewer" VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="ChatItems">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,0,6" ToolTip="{Binding Source}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Prefix}" FontWeight="SemiBold" Foreground="#9CFF37" FontSize="16">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsChecked, ElementName=ShowSourceSpeakerToggle}" Value="False">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Grid.Column="1" Text="{Binding Translation}" Foreground="#F7F6F0" FontSize="16"
                                           TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>
        <Border Grid.Row="2" Background="#202A28" BorderBrush="#52645F" BorderThickness="1" Padding="10" Margin="0,10,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBox x:Name="ChatInputTextBox"
                         MinHeight="54"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         Padding="8"
                         PreviewKeyDown="ChatInputPreviewKeyDown" />
                <Grid Grid.Row="1" Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="ChatSendStatusText"
                               Text="Enter로 중국어 번역 후 클립보드에 복사합니다. 줄바꿈은 Shift+Enter입니다."
                               Foreground="#B7C6C2"
                               TextWrapping="Wrap"
                               VerticalAlignment="Center"
                               FontSize="12" />
                    <Button x:Name="SendChatButton"
                            Grid.Column="1"
                            Width="150"
                            Height="32"
                            Margin="10,0,0,0"
                            Content="번역해서 복사"
                            Click="SendTranslatedChat" />
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
