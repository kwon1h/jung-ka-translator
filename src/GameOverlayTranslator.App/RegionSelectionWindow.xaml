<Window x:Class="GameOverlayTranslator.App.RegionSelectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True" KeyDown="OnKeyDown">
    <Grid>
        <Canvas x:Name="SelectionCanvas" Background="Transparent" Cursor="Cross" Focusable="True"
                PreviewMouseLeftButtonDown="BeginSelection"
                PreviewMouseRightButtonDown="BeginSelection"
                PreviewMouseMove="UpdateSelection"
                PreviewMouseLeftButtonUp="CompleteSelection"
                PreviewMouseRightButtonUp="CompleteSelection" />

        <Border Background="#E6172121" Padding="12" Margin="14" CornerRadius="6"
                HorizontalAlignment="Left" VerticalAlignment="Top" IsHitTestVisible="False">
            <StackPanel>
                <TextBlock Text="번역 영역 편집" FontWeight="Bold" Foreground="#F7F6F0" />
                <TextBlock Margin="0,4,0,0" Foreground="#D8E4E1"
                           Text="좌클릭 드래그: 번역 영역 추가 · 우클릭 드래그: 제외 영역 추가" />
                <TextBlock Foreground="#D8E4E1"
                           Text="기존 영역: 내부 드래그로 이동 · 테두리 드래그로 크기 변경 · Delete로 삭제" />
                <TextBlock Margin="0,4,0,0" Foreground="#93E8D5"
                           Text="초록색 번역 · 빨간색 제외 · Enter 저장 · Esc 취소" />
            </StackPanel>
        </Border>

        <StackPanel Margin="14" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
            <Button Content="전체 지우기" Padding="12,7" Margin="0,0,8,0" Click="ClearAllRegions" />
            <Button Content="취소" Padding="12,7" Margin="0,0,8,0" Click="CancelEditing" />
            <Button Content="저장" Padding="18,7" Click="SaveEditing" Background="#35C3A7" FontWeight="Bold" />
        </StackPanel>
    </Grid>
</Window>
