<Window x:Class="GameOverlayTranslator.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Game OCR Translator" Height="620" Width="760" MinHeight="560" MinWidth="660"
        Background="#F4F3EE" PreviewKeyDown="OnPreviewKeyDown">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="Game OCR Translator" FontSize="28" FontWeight="SemiBold" Foreground="#172121" />
            <TextBlock Text="창모드 또는 전체창모드 게임 창과 OCR 영역을 선택해 번역을 시작합니다." Margin="0,6,0,0" Foreground="#40514E" />
        </StackPanel>
        <Grid Grid.Row="1" Margin="0,22,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="게임 창" FontWeight="SemiBold" />
                <DockPanel Margin="0,8,0,18">
                    <Button DockPanel.Dock="Right" Width="88" Margin="8,0,0,0" Content="새로고침" Click="RefreshWindows" />
                    <ComboBox x:Name="WindowComboBox" MinHeight="32" SelectionChanged="WindowSelectionChanged" />
                </DockPanel>
                <TextBlock Text="번역 영역" FontWeight="SemiBold" />
                <DockPanel Margin="0,8,0,18">
                    <Button Width="120" Content="영역 선택" Click="SelectRegion" />
                    <TextBlock x:Name="RegionText" Margin="12,5,0,0" Text="선택되지 않음" TextWrapping="Wrap" />
                </DockPanel>
                <UniformGrid Columns="2" Margin="0,0,0,18">
                    <StackPanel Margin="0,0,8,0">
                        <TextBlock Text="OCR 언어" FontWeight="SemiBold" />
                        <ComboBox x:Name="OcrLanguageComboBox" Margin="0,8,0,0" MinHeight="32" />
                    </StackPanel>
                    <StackPanel Margin="8,0,0,0">
                        <TextBlock Text="번역 언어" FontWeight="SemiBold" />
                        <ComboBox x:Name="TargetLanguageComboBox" Margin="0,8,0,0" MinHeight="32" />
                    </StackPanel>
                </UniformGrid>
                <TextBlock Text="번역 표시" FontWeight="SemiBold" />
                <ComboBox x:Name="DisplayModeComboBox" Margin="0,8,0,18" MinHeight="32"
                          SelectionChanged="DisplayModeSelectionChanged" />
                <TextBlock Text="DeepL API Free 인증 키" FontWeight="SemiBold" />
                <DockPanel Margin="0,8,0,10">
                    <Button DockPanel.Dock="Right" Width="64" Margin="8,0,0,0" Content="삭제" Click="DeleteApiKey" />
                    <Button DockPanel.Dock="Right" Width="64" Margin="8,0,0,0" Content="저장" Click="SaveApiKey" />
                    <PasswordBox x:Name="ApiKeyPasswordBox" MinHeight="32" />
                </DockPanel>
                <TextBlock Text="키는 현재 Windows 사용자 범위로 보호해 저장합니다." Foreground="#40514E" FontSize="12" />
            </StackPanel>
            <Border Grid.Column="2" Background="#FCFBF7" BorderBrush="#C7C4B8" BorderThickness="1" CornerRadius="6" Padding="18">
                <StackPanel>
                    <TextBlock Text="세션" FontSize="18" FontWeight="SemiBold" />
                    <TextBlock x:Name="StatusText" Text="대기" Margin="0,14,0,18" Padding="12" Background="#E2E8DD" TextWrapping="Wrap" />
                    <Button x:Name="StartStopButton" Height="42" Content="번역 시작 (F8)" Click="ToggleSession" />
                    <Button Margin="0,10,0,0" Height="36" Content="영역 다시 선택 (F9)" Click="SelectRegion" />
                    <Button Margin="0,10,0,0" Height="36" Content="모듈 테스터" Click="OpenModuleTesters" />
                    <Separator Margin="0,20,0,16" />
                    <TextBlock Text="결과 창" FontWeight="SemiBold" />
                    <TextBlock Text="번역을 시작하면 별도 창에 원문과 번역문을 위아래로 표시합니다." Margin="0,8,0,0" Foreground="#40514E" TextWrapping="Wrap" />
                    <TextBlock Text="독점 전체 화면 게임은 v1 지원 범위 밖입니다." Margin="0,18,0,0" Foreground="#7A3E2B" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </Grid>
        <TextBlock Grid.Row="2" Foreground="#40514E" Text="단축키: F8 시작/정지, F9 영역 선택. 시작 전 게임 화면이 보이는 상태여야 합니다." />
    </Grid>
</Window>
