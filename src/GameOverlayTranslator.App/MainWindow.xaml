<Window x:Class="GameOverlayTranslator.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:GameOverlayTranslator.App"
        Title="중카 번역기 (Game OCR Translator)"
        Width="1280" Height="800" MinWidth="1180" MinHeight="680"
        Loaded="MainWindowLoaded"
        Activated="MainWindowActivated"
        Deactivated="MainWindowDeactivated"
        Background="#F5F7FA">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#F3F4F6" />
            <Setter Property="Foreground" Value="#1F2937" />
            <Setter Property="BorderBrush" Value="#D1D5DB" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.9" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.75" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#2563EB" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="#2563EB" />
            <Setter Property="FontSize" Value="14" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1D4ED8" />
                    <Setter Property="BorderBrush" Value="#1D4ED8" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DangerButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#FEF2F2" />
            <Setter Property="Foreground" Value="#DC2626" />
            <Setter Property="BorderBrush" Value="#FECACA" />
        </Style>

        <Style x:Key="LinkButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#2563EB" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="2" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Focusable" Value="False" />
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Padding" Value="9,7" />
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="9,7" />
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style TargetType="PasswordBox">
            <Setter Property="Padding" Value="9,7" />
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#E5E7EB" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="11" />
            <Setter Property="Padding" Value="16" />
        </Style>

        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#4B5563" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>

        <Style x:Key="NavTabItemStyle" TargetType="TabItem">
            <Setter Property="Width" Value="94" />
            <Setter Property="Height" Value="76" />
            <Setter Property="Foreground" Value="#6B7280" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="NavBorder"
                                Margin="8,5"
                                CornerRadius="9"
                                BorderThickness="3,0,0,0"
                                BorderBrush="Transparent"
                                Background="Transparent">
                            <ContentPresenter ContentSource="Header"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="NavBorder" Property="Background" Value="#EFF6FF" />
                                <Setter TargetName="NavBorder" Property="BorderBrush" Value="#2563EB" />
                                <Setter Property="Foreground" Value="#2563EB" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="NavBorder" Property="Background" Value="#F3F4F6" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SegmentRadioStyle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#4B5563" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="SegmentBorder"
                                Background="#F9FAFB"
                                BorderBrush="#E5E7EB"
                                BorderThickness="1"
                                CornerRadius="7"
                                Padding="12,9"
                                Margin="2,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="SegmentBorder" Property="Background" Value="#EFF6FF" />
                                <Setter TargetName="SegmentBorder" Property="BorderBrush" Value="#2563EB" />
                                <Setter Property="Foreground" Value="#1D4ED8" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SegmentListBoxItemStyle" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="#4B5563" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="SegmentBorder"
                                Background="#F9FAFB"
                                BorderBrush="#E5E7EB"
                                BorderThickness="1"
                                CornerRadius="7"
                                Padding="12,9"
                                Margin="2,0">
                            <ContentPresenter HorizontalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="SegmentBorder" Property="Background" Value="#EFF6FF" />
                                <Setter TargetName="SegmentBorder" Property="BorderBrush" Value="#2563EB" />
                                <Setter Property="Foreground" Value="#1D4ED8" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ColorSwatchItemStyle" TargetType="ListBoxItem">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="SelectionRing" BorderBrush="Transparent" BorderThickness="2" CornerRadius="13" Padding="2" Margin="1">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="SelectionRing" Property="BorderBrush" Value="#2563EB" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="SelectionRing" Property="BorderBrush" Value="#D1D5DB" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#E5E7EB" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="RowBackground" Value="White" />
            <Setter Property="AlternatingRowBackground" Value="#F9FAFB" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="HorizontalGridLinesBrush" Value="#F3F4F6" />
            <Setter Property="VerticalGridLinesBrush" Value="Transparent" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="AutoGenerateColumns" Value="False" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="RowHeaderWidth" Value="0" />
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#F3F4F6" />
            <Setter Property="Foreground" Value="#374151" />
            <Setter Property="Padding" Value="8,7" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style TargetType="DataGridCell">
            <Setter Property="Padding" Value="8,6" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="58" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="White" BorderBrush="#E5E7EB" BorderThickness="0,0,0,1">
            <Grid Margin="18,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Width="28" Height="28" CornerRadius="7" Background="#2563EB" VerticalAlignment="Center">
                    <TextBlock Text="文" Foreground="White" FontWeight="Bold" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock Grid.Column="1" Text="중카 번역기" FontSize="18" FontWeight="Bold" Foreground="#111827" Margin="10,0,0,0" VerticalAlignment="Center" />
                <Border Grid.Column="2" Background="#F3F4F6" CornerRadius="12" Padding="10,4" Margin="18,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Left" MaxWidth="650">
                    <TextBlock x:Name="StatusText" Text="대기" Foreground="#374151" FontSize="12" TextTrimming="CharacterEllipsis" />
                </Border>
                <TextBlock Grid.Column="3" Text="게임 화면 번역 도구" Foreground="#9CA3AF" FontSize="11" VerticalAlignment="Center" />
            </Grid>
        </Border>

        <TabControl Grid.Row="1" TabStripPlacement="Left" Background="Transparent" BorderThickness="0">
            <TabItem Style="{StaticResource NavTabItemStyle}" AutomationProperties.Name="번역">
                <TabItem.Header>
                    <StackPanel>
                        <TextBlock Text="&#xE7C4;" FontFamily="Segoe MDL2 Assets" FontSize="22" HorizontalAlignment="Center" />
                        <TextBlock Text="번역" Margin="0,6,0,0" HorizontalAlignment="Center" />
                    </StackPanel>
                </TabItem.Header>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="22" MaxWidth="1440">
                        <Border Style="{StaticResource CardStyle}" Padding="14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.25*" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="1.1*" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="1.25*" />
                                    <ColumnDefinition Width="18" />
                                    <ColumnDefinition Width="180" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="1  게임 창" Style="{StaticResource FieldLabelStyle}" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <ComboBox x:Name="WindowComboBox" SelectionChanged="WindowSelectionChanged" />
                                        <Button Grid.Column="1" Margin="7,0,0,0" Content="새로고침" Click="RefreshWindows" ToolTip="캡처 가능한 창 목록과 미리보기를 갱신합니다." />
                                    </Grid>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="2  번역 모드" Style="{StaticResource FieldLabelStyle}" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <RadioButton x:Name="ChatTranslationRadioButton" Grid.Column="0" Content="채팅 번역" GroupName="TranslationMode" IsChecked="True" Checked="TranslationModeChanged" Style="{StaticResource SegmentRadioStyle}" />
                                        <RadioButton x:Name="ScreenTranslationRadioButton" Grid.Column="1" Content="전체화면 번역" GroupName="TranslationMode" Checked="TranslationModeChanged" Style="{StaticResource SegmentRadioStyle}" />
                                    </Grid>
                                </StackPanel>

                                <StackPanel Grid.Column="4">
                                    <TextBlock Text="3  표시 방식" Style="{StaticResource FieldLabelStyle}" />
                                    <ListBox x:Name="DisplayModeComboBox"
                                             Height="38"
                                             BorderThickness="0"
                                             Background="Transparent"
                                             SelectionMode="Single"
                                             ItemContainerStyle="{StaticResource SegmentListBoxItemStyle}"
                                             SelectionChanged="DisplayModeSelectionChanged"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                             ScrollViewer.VerticalScrollBarVisibility="Disabled">
                                        <ListBox.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <UniformGrid Rows="1" />
                                            </ItemsPanelTemplate>
                                        </ListBox.ItemsPanel>
                                    </ListBox>
                                </StackPanel>

                                <Button x:Name="StartStopButton" Grid.Column="6" Height="58" Content="번역 시작" Click="ToggleSession" Style="{StaticResource PrimaryButtonStyle}" FontWeight="Bold" VerticalAlignment="Bottom" />
                            </Grid>
                        </Border>

                        <Grid Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="286" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Style="{StaticResource CardStyle}" Padding="14">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="게임 미리보기 및 영역 설정" FontWeight="Bold" FontSize="14" Foreground="#111827" />
                                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                <TextBlock Text="● 번역 영역" Foreground="#16A34A" FontSize="11" />
                                                <TextBlock Text="● 제외 영역" Foreground="#EF4444" FontSize="11" Margin="12,0,0,0" />
                                                <TextBlock x:Name="RegionText" Text="선택되지 않음" Foreground="#6B7280" FontSize="11" Margin="12,0,0,0" />
                                            </StackPanel>
                                        </StackPanel>
                                        <Button x:Name="ClearRegionButton" Grid.Column="1" Content="영역 해제" Click="ClearRegion" Margin="0,0,8,0" />
                                        <Button x:Name="SelectRegionButton" Grid.Column="2" Content="영역 편집" Click="SelectRegion" IsEnabled="True" Background="#EFF6FF" Foreground="#1D4ED8" BorderBrush="#BFDBFE" />
                                    </Grid>

                                    <Border Grid.Row="1" Background="#111827" CornerRadius="8" ClipToBounds="True" MinHeight="330">
                                        <Grid>
                                            <Viewbox Stretch="Uniform">
                                                <Grid x:Name="PreviewSurface" Width="1280" Height="720" Background="#111827">
                                                    <Image x:Name="GamePreviewImage" Stretch="Fill" />
                                                    <Canvas x:Name="PreviewRegionCanvas" IsHitTestVisible="False" />
                                                </Grid>
                                            </Viewbox>
                                            <Border x:Name="PreviewPlaceholderBorder" Background="#111827">
                                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="420">
                                                    <TextBlock Text="&#xE722;" FontFamily="Segoe MDL2 Assets" FontSize="34" Foreground="#64748B" HorizontalAlignment="Center" />
                                                    <TextBlock x:Name="PreviewPlaceholderText" Text="게임 창을 선택하면 실제 화면 미리보기가 표시됩니다." Foreground="#CBD5E1" FontSize="13" TextAlignment="Center" TextWrapping="Wrap" Margin="0,10,0,0" />
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                    </Border>

                                    <Grid Grid.Row="2" Margin="2,9,2,0">
                                        <TextBlock Text="영역 편집에서 좌클릭은 번역 영역, 우클릭은 제외 영역을 추가합니다." Foreground="#6B7280" FontSize="11" />
                                        <TextBlock x:Name="PreviewTimestampText" Text="미리보기 대기" Foreground="#9CA3AF" FontSize="11" HorizontalAlignment="Right" />
                                    </Grid>
                                </Grid>
                            </Border>

                            <StackPanel Grid.Column="2">
                                <Border Style="{StaticResource CardStyle}">
                                    <StackPanel>
                                        <TextBlock Text="현재 설정" FontWeight="Bold" FontSize="14" Foreground="#111827" Margin="0,0,0,12" />
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="30" />
                                                <RowDefinition Height="30" />
                                                <RowDefinition Height="30" />
                                                <RowDefinition Height="30" />
                                                <RowDefinition Height="30" />
                                            </Grid.RowDefinitions>
                                            <TextBlock Text="OCR" Foreground="#6B7280" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1" Text="{Binding SelectedItem, ElementName=OcrLanguageComboBox}" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                            <TextBlock Grid.Row="1" Text="번역" Foreground="#6B7280" VerticalAlignment="Center" />
                                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedItem, ElementName=TargetLanguageComboBox}" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                            <TextBlock Grid.Row="2" Text="표시 방식" Foreground="#6B7280" VerticalAlignment="Center" />
                                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SelectedItem, ElementName=DisplayModeComboBox}" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                            <TextBlock Grid.Row="3" Text="표시 시간" Foreground="#6B7280" VerticalAlignment="Center" />
                                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Text, ElementName=OverlayDurationLabel}" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                            <TextBlock Grid.Row="4" Text="글꼴" Foreground="#6B7280" VerticalAlignment="Center" />
                                            <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding SelectedItem, ElementName=FontFamilyComboBox}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="120" />
                                                <TextBlock Text=" · " Foreground="#9CA3AF" />
                                                <TextBlock Text="{Binding Text, ElementName=FontSizeLabel}" FontWeight="SemiBold" />
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource CardStyle}" Margin="0,14,0,0">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,10">
                                            <TextBlock Text="실시간 상태" FontWeight="Bold" FontSize="14" Foreground="#111827" />
                                            <TextBlock x:Name="ApiUsageText" Text="이번 세션 0건 / 0자" Foreground="#6B7280" FontSize="10" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                        </Grid>
                                        <TextBlock x:Name="ReadyWindowText" TextWrapping="Wrap" FontSize="11" Margin="0,0,0,6" />
                                        <TextBlock x:Name="ReadyRegionText" TextWrapping="Wrap" FontSize="11" Margin="0,0,0,6" />
                                        <TextBlock x:Name="ReadyOcrText" TextWrapping="Wrap" FontSize="11" Margin="0,0,0,6" />
                                        <TextBlock x:Name="ReadyTranslatorText" TextWrapping="Wrap" FontSize="11" Margin="0,0,0,6" />
                                        <TextBlock x:Name="ReadyDictionaryText" TextWrapping="Wrap" FontSize="11" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>

                        <Expander Margin="0,14,0,0" IsExpanded="False">
                            <Expander.Header>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE774;" FontFamily="Segoe MDL2 Assets" Foreground="#2563EB" Margin="0,0,9,0" />
                                    <TextBlock Text="OCR 및 언어" FontWeight="Bold" />
                                    <TextBlock Text="  OCR 엔진, 인식 언어, 번역 언어" Foreground="#9CA3AF" FontSize="11" />
                                </StackPanel>
                            </Expander.Header>
                            <Border Style="{StaticResource CardStyle}" Margin="0,8,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="14" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="14" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="OCR 엔진" Style="{StaticResource FieldLabelStyle}" />
                                        <ComboBox x:Name="OcrEngineComboBox" SelectionChanged="OcrEngineSelectionChanged" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="OCR 언어" Style="{StaticResource FieldLabelStyle}" />
                                        <ComboBox x:Name="OcrLanguageComboBox" SelectionChanged="OcrLanguageSelectionChanged" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="4">
                                        <TextBlock Text="번역 언어" Style="{StaticResource FieldLabelStyle}" />
                                        <ComboBox x:Name="TargetLanguageComboBox" SelectionChanged="TargetLanguageSelectionChanged" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Expander>

                        <Expander Margin="0,10,0,0" IsExpanded="False">
                            <Expander.Header>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE790;" FontFamily="Segoe MDL2 Assets" Foreground="#2563EB" Margin="0,0,9,0" />
                                    <TextBlock Text="오버레이 스타일" FontWeight="Bold" />
                                    <TextBlock Text="  글꼴, 색상, 배경, 투명도" Foreground="#9CA3AF" FontSize="11" />
                                </StackPanel>
                            </Expander.Header>
                            <Border Style="{StaticResource CardStyle}" Margin="0,8,0,0">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="14" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="14" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="가독성 프리셋" Style="{StaticResource FieldLabelStyle}" />
                                            <ComboBox x:Name="OverlayPresetComboBox" SelectionChanged="OverlayPresetSelectionChanged" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <Grid>
                                                <TextBlock Text="오버레이 투명도" Style="{StaticResource FieldLabelStyle}" />
                                                <TextBlock x:Name="OverlayOpacityLabel" Text="92%" Foreground="#2563EB" FontWeight="SemiBold" HorizontalAlignment="Right" />
                                            </Grid>
                                            <Slider x:Name="OverlayOpacitySlider" Minimum="0.25" Maximum="1" Value="0.92" TickFrequency="0.01" ValueChanged="OverlayOpacitySlider_ValueChanged" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="4">
                                            <Grid>
                                                <TextBlock Text="번역 유지시간" Style="{StaticResource FieldLabelStyle}" />
                                                <TextBlock x:Name="OverlayDurationLabel" Text="4초" Foreground="#2563EB" FontWeight="SemiBold" HorizontalAlignment="Right" />
                                            </Grid>
                                            <Slider x:Name="OverlayDurationSlider" Minimum="1" Maximum="15" Value="4" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="OverlayDurationSlider_ValueChanged" />
                                        </StackPanel>
                                    </Grid>

                                    <CheckBox x:Name="ShowOverlayInScreenShareCheckBox" Content="화면 공유/방송 시 오버레이 표시 (캡처 시 깜빡임 발생)" Checked="ShowOverlayInScreenShareChanged" Unchecked="ShowOverlayInScreenShareChanged" Margin="0,14,0,14" FontWeight="SemiBold" Foreground="#374151" />

                                    <Separator Margin="0,0,0,14" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="1.2*" />
                                            <ColumnDefinition Width="14" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="14" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="글꼴" Style="{StaticResource FieldLabelStyle}" />
                                            <ComboBox x:Name="FontFamilyComboBox" SelectionChanged="FontFamilySelectionChanged" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <Grid>
                                                <TextBlock Text="글꼴 크기" Style="{StaticResource FieldLabelStyle}" />
                                                <TextBlock x:Name="FontSizeLabel" Text="20pt" Foreground="#2563EB" FontWeight="SemiBold" HorizontalAlignment="Right" />
                                            </Grid>
                                            <Slider x:Name="FontSizeSlider" Minimum="12" Maximum="48" IsSnapToTickEnabled="True" TickFrequency="1" ValueChanged="FontSizeSlider_ValueChanged" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="4">
                                            <Grid>
                                                <TextBlock Text="테두리 두께" Style="{StaticResource FieldLabelStyle}" />
                                                <TextBlock x:Name="StrokeThicknessLabel" Text="0.5px" Foreground="#2563EB" FontWeight="SemiBold" HorizontalAlignment="Right" />
                                            </Grid>
                                            <Slider x:Name="StrokeThicknessSlider" Minimum="0" Maximum="1" TickFrequency="0.1" ValueChanged="StrokeThicknessSlider_ValueChanged" />
                                        </StackPanel>
                                    </Grid>

                                    <Grid Margin="0,14,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="14" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="14" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="글자 색" Style="{StaticResource FieldLabelStyle}" />
                                            <ListBox x:Name="TextColorListBox" ItemContainerStyle="{StaticResource ColorSwatchItemStyle}" BorderThickness="0" Background="Transparent" SelectionChanged="TextColorSelectionChanged" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled">
                                                <ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ListBox.ItemsPanel>
                                                <ListBox.ItemTemplate><DataTemplate><Ellipse Width="22" Height="22" Fill="{Binding HexBrush}" ToolTip="{Binding Name}" Cursor="Hand" Margin="2" /></DataTemplate></ListBox.ItemTemplate>
                                            </ListBox>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="테두리 색" Style="{StaticResource FieldLabelStyle}" />
                                            <ListBox x:Name="OutlineColorListBox" ItemContainerStyle="{StaticResource ColorSwatchItemStyle}" BorderThickness="0" Background="Transparent" SelectionChanged="OutlineColorSelectionChanged" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled">
                                                <ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ListBox.ItemsPanel>
                                                <ListBox.ItemTemplate><DataTemplate><Ellipse Width="22" Height="22" Fill="{Binding HexBrush}" ToolTip="{Binding Name}" Cursor="Hand" Margin="2" /></DataTemplate></ListBox.ItemTemplate>
                                            </ListBox>
                                        </StackPanel>
                                        <StackPanel Grid.Column="4">
                                            <TextBlock Text="배경 색" Style="{StaticResource FieldLabelStyle}" />
                                            <ListBox x:Name="BackgroundColorsListBox" ItemContainerStyle="{StaticResource ColorSwatchItemStyle}" BorderThickness="0" Background="Transparent" SelectionChanged="BackgroundColorSelectionChanged" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled">
                                                <ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ListBox.ItemsPanel>
                                                <ListBox.ItemTemplate><DataTemplate><Ellipse Width="22" Height="22" Fill="{Binding HexBrush}" ToolTip="{Binding Name}" Cursor="Hand" Margin="2" /></DataTemplate></ListBox.ItemTemplate>
                                            </ListBox>
                                        </StackPanel>
                                    </Grid>

                                    <Grid Margin="0,14,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="14" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <Grid>
                                                <TextBlock Text="배경 투명도" Style="{StaticResource FieldLabelStyle}" />
                                                <TextBlock x:Name="BackgroundOpacityLabel" Text="60%" Foreground="#2563EB" FontWeight="SemiBold" HorizontalAlignment="Right" />
                                            </Grid>
                                            <Slider x:Name="BackgroundOpacitySlider" Minimum="0" Maximum="1" TickFrequency="0.01" ValueChanged="BackgroundOpacitySlider_ValueChanged" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="폰트 예시 미리보기" Style="{StaticResource FieldLabelStyle}" />
                                            <Border x:Name="FontPreviewBgBorder" Background="#99000000" CornerRadius="6" Padding="12,8">
                                                <local:OutlinedTextBlock x:Name="FontPreviewTextBlock" Text="번역 예시입니다" FontSize="20" FontWeight="Bold" Fill="White" Stroke="Black" StrokeThickness="0.5" />
                                            </Border>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </Expander>

                        <TextBlock Text="독점 전체화면 게임(Exclusive Fullscreen)은 창모드(Windowed) 전환이 필요합니다." Foreground="#9CA3AF" FontSize="11" HorizontalAlignment="Center" Margin="0,18,0,4" />

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Style="{StaticResource NavTabItemStyle}" AutomationProperties.Name="사전">
                <TabItem.Header>
                    <StackPanel>
                        <TextBlock Text="&#xE82D;" FontFamily="Segoe MDL2 Assets" FontSize="22" HorizontalAlignment="Center" />
                        <TextBlock Text="사전" Margin="0,6,0,0" HorizontalAlignment="Center" />
                    </StackPanel>
                </TabItem.Header>
                <Grid Margin="22">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="14" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Border Style="{StaticResource CardStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="12" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid>
                                <StackPanel>
                                    <TextBlock Text="유저 사전" FontSize="17" FontWeight="Bold" Foreground="#111827" />
                                    <TextBlock Text="OCR 원문을 원하는 한국어 표현으로 우선 치환합니다." Foreground="#6B7280" FontSize="11" Margin="0,4,0,0" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button x:Name="RestoreDefaultsButton" Content="기본 사전 추가" Click="RestoreDefaultDictionary" Margin="0,0,8,0" Background="#F0FDF4" Foreground="#15803D" BorderBrush="#BBF7D0" />
                                    <Button x:Name="DeleteDictEntryButton" Content="선택 삭제" Click="DeleteDictionaryEntry" Style="{StaticResource DangerButtonStyle}" />
                                </StackPanel>
                            </Grid>
                            <DataGrid x:Name="UserDictionaryDataGrid" Grid.Row="2" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" SelectionMode="Single">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="분류" Binding="{Binding Category}" Width="120" />
                                    <DataGridTextColumn Header="원문 단어 (중국어)" Binding="{Binding Source}" Width="*" />
                                    <DataGridTextColumn Header="대체 번역어 (한국어)" Binding="{Binding Target}" Width="*" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>

                    <Border Grid.Row="2" Style="{StaticResource CardStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="10" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="새 단어 추가" FontWeight="Bold" FontSize="14" />
                            <Grid Grid.Row="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="135" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="1.15*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="130" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="분류" Style="{StaticResource FieldLabelStyle}" />
                                    <ComboBox x:Name="DictCategoryComboBox" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="원문 단어" Style="{StaticResource FieldLabelStyle}" />
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <TextBox x:Name="DictSourceTextBox" />
                                        <Button x:Name="FillDictSourceFromOcrButton" Grid.Column="1" Content="화면 OCR" Click="FillDictionarySourceFromOcr" Margin="7,0,0,0" Background="#F5F3FF" Foreground="#6D28D9" BorderBrush="#DDD6FE" />
                                    </Grid>
                                </StackPanel>
                                <StackPanel Grid.Column="4">
                                    <TextBlock Text="대체 번역어" Style="{StaticResource FieldLabelStyle}" />
                                    <TextBox x:Name="DictTargetTextBox" />
                                </StackPanel>
                                <Button x:Name="AddDictEntryButton" Grid.Column="6" Content="사전 단어 추가" Click="AddDictionaryEntry" Style="{StaticResource PrimaryButtonStyle}" VerticalAlignment="Bottom" />
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Style="{StaticResource NavTabItemStyle}" AutomationProperties.Name="진단">
                <TabItem.Header>
                    <StackPanel>
                        <TextBlock Text="&#xE9D9;" FontFamily="Segoe MDL2 Assets" FontSize="22" HorizontalAlignment="Center" />
                        <TextBlock Text="진단" Margin="0,6,0,0" HorizontalAlignment="Center" />
                    </StackPanel>
                </TabItem.Header>
                <Grid Margin="22">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="14" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Border Style="{StaticResource CardStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="12" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid>
                                <StackPanel>
                                    <TextBlock Text="진단 로그" FontSize="17" FontWeight="Bold" />
                                    <TextBlock Text="최근 100개의 OCR·필터·번역 결과를 표시합니다." Foreground="#6B7280" FontSize="11" Margin="0,4,0,0" />
                                </StackPanel>
                                <Button Content="로그 비우기" Click="ClearDiagnosticLogs" HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </Grid>
                            <DataGrid x:Name="DiagnosticLogsListView" Grid.Row="2"
                                      AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                                      CanUserReorderColumns="True" CanUserResizeColumns="True"
                                      ClipboardCopyMode="IncludeHeader" IsReadOnly="True"
                                      SelectionMode="Extended" SelectionUnit="CellOrRowHeader"
                                      ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="시간" Binding="{Binding Time}" Width="80" />
                                    <DataGridTextColumn Header="상태" Binding="{Binding Status}" Width="110" />
                                    <DataGridTextColumn Header="원문 / 내용" Binding="{Binding Source}" Width="*" MinWidth="250" />
                                    <DataGridTextColumn Header="필터 규칙" Binding="{Binding Rule}" Width="120" />
                                    <DataGridTextColumn Header="상세 이유" Binding="{Binding Reason}" Width="220" />
                                    <DataGridTextColumn Header="API 사용" Binding="{Binding ApiUsage}" Width="100" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>
                    <Border Grid.Row="2" Style="{StaticResource CardStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="수동 OCR 텍스트 테스트" Style="{StaticResource FieldLabelStyle}" />
                                <TextBox x:Name="ManualOcrTestTextBox" TextWrapping="Wrap" ToolTip="예: zuyeong: 快帮我!" />
                            </StackPanel>
                            <Button Grid.Column="1" Content="파서 테스트" Click="RunManualOcrParserTest" Margin="10,0,0,0" Width="112" VerticalAlignment="Bottom" />
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Style="{StaticResource NavTabItemStyle}" AutomationProperties.Name="설정">
                <TabItem.Header>
                    <StackPanel>
                        <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="22" HorizontalAlignment="Center" />
                        <TextBlock Text="설정" Margin="0,6,0,0" HorizontalAlignment="Center" />
                    </StackPanel>
                </TabItem.Header>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="22" MaxWidth="820" HorizontalAlignment="Left">
                        <TextBlock Text="설정" FontSize="22" FontWeight="Bold" Foreground="#111827" />
                        <TextBlock Text="번역 서비스처럼 자주 바꾸지 않는 항목을 관리합니다." Foreground="#6B7280" Margin="0,5,0,16" />
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="번역 서비스" FontSize="16" FontWeight="Bold" Margin="0,0,0,14" />
                                <TextBlock Text="번역 서비스 선택" Style="{StaticResource FieldLabelStyle}" />
                                <ComboBox x:Name="TranslatorTypeComboBox" Margin="0,0,0,16" SelectionChanged="TranslatorTypeComboBox_SelectionChanged">
                                    <ComboBoxItem Content="DeepL API (추천/개인 키 필요)" Tag="DeepL" />
                                    <ComboBoxItem Content="Google 번역 (무료/비공식 API)" Tag="GoogleUnofficial" />
                                    <ComboBoxItem Content="Google Apps Script (무료/개인 웹앱)" Tag="GoogleWebApp" />
                                </ComboBox>

                                <StackPanel x:Name="DeepLSettingsPanel" Visibility="Visible">
                                    <Grid Margin="0,0,0,7">
                                        <TextBlock Text="DeepL API Free 인증 키" Style="{StaticResource FieldLabelStyle}" />
                                        <Button Content="API 키 발급받기 ↗" Click="OpenDeepLApiKeysPage" Style="{StaticResource LinkButtonStyle}" HorizontalAlignment="Right" />
                                    </Grid>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <PasswordBox x:Name="ApiKeyPasswordBox" />
                                        <Button Grid.Column="1" Content="저장" Click="SaveApiKey" Margin="8,0,0,0" Width="68" />
                                        <Button Grid.Column="2" Content="삭제" Click="DeleteApiKey" Margin="8,0,0,0" Width="68" Style="{StaticResource DangerButtonStyle}" />
                                    </Grid>
                                    <TextBlock Text="인증 키는 로컬 PC에 안전하게 암호화되어 저장됩니다." Foreground="#6B7280" FontSize="11" Margin="0,8,0,0" />
                                </StackPanel>

                                <StackPanel x:Name="GoogleUnofficialSettingsPanel" Visibility="Collapsed">
                                    <Border Background="#F9FAFB" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="8" Padding="12">
                                        <TextBlock Text="API 키 없이 사용하는 비공식 구글 번역 서비스입니다. 요청량이 많으면 일시적으로 제한될 수 있습니다." Foreground="#4B5563" TextWrapping="Wrap" />
                                    </Border>
                                </StackPanel>

                                <StackPanel x:Name="GoogleWebAppSettingsPanel" Visibility="Collapsed">
                                    <TextBlock Text="Google Apps Script 웹 앱 URL" Style="{StaticResource FieldLabelStyle}" />
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <TextBox x:Name="GoogleWebAppUrlTextBox" />
                                        <Button Grid.Column="1" Content="저장" Click="SaveGoogleWebAppUrl" Margin="8,0,0,0" Width="72" />
                                    </Grid>
                                    <TextBlock Text="개인 Google Apps Script 웹 앱을 배포한 뒤 URL을 입력하세요." Foreground="#6B7280" FontSize="11" Margin="0,8,0,0" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
