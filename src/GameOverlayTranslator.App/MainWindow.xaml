<Window x:Class="GameOverlayTranslator.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:GameOverlayTranslator.App"
        Title="중카 번역기 (Game OCR Translator)" Height="650" Width="820" MinHeight="620" MinWidth="800"
        Loaded="MainWindowLoaded"
        Background="#F5F6F8">
    <Window.Resources>
        <!-- Modern Rounded Button Style -->
        <Style TargetType="Button">
            <Setter Property="Background" Value="#E5E8EB" />
            <Setter Property="Foreground" Value="#1C1C1E" />
            <Setter Property="BorderBrush" Value="#D1D5DB" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#D8DCE0" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.5" />
                </Trigger>
            </Style.Triggers>
        </Style>
        
        <!-- Styled ComboBox and PasswordBox -->
        <Style TargetType="ComboBox">
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style TargetType="PasswordBox">
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        
        <!-- Style for Color Swatch ListBoxItem -->
        <Style x:Key="ColorSwatchItemStyle" TargetType="ListBoxItem">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="SelectionRing" BorderBrush="Transparent" BorderThickness="2" CornerRadius="12" Padding="2" Margin="1">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="SelectionRing" Property="BorderBrush" Value="#2563EB" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="SelectionRing" Property="BorderBrush" Value="#D1D5DB" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern TabControl Style -->
        <Style TargetType="TabControl">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="Padding" Value="14,10" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#4B5563" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Border" BorderThickness="0,0,0,2" BorderBrush="Transparent" Padding="{TemplateBinding Padding}" Margin="0,0,8,0" Cursor="Hand">
                            <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Border" Property="BorderBrush" Value="#2563EB" />
                                <Setter Property="Foreground" Value="#2563EB" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#1F2937" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern DataGrid Style -->
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#E5E7EB" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="RowBackground" Value="White" />
            <Setter Property="AlternatingRowBackground" Value="#F9FAFB" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="HorizontalGridLinesBrush" Value="#F3F4F6" />
            <Setter Property="VerticalGridLinesBrush" Value="Transparent" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="AutoGenerateColumns" Value="False" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="RowHeaderWidth" Value="0" />
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#F3F4F6" />
            <Setter Property="Foreground" Value="#374151" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Height" Value="28" />
        </Style>
        <Style TargetType="DataGridCell">
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern ListView/GridView Styles -->
        <Style TargetType="ListView">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#E5E7EB" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style TargetType="GridViewColumnHeader">
            <Setter Property="Background" Value="#F3F4F6" />
            <Setter Property="Foreground" Value="#374151" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Height" Value="28" />
        </Style>
    </Window.Resources>
    
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        
        <!-- Header -->
        <StackPanel>
            <TextBlock Text="중카 번역기" FontSize="26" FontWeight="Bold" Foreground="#1F2937" />
            <TextBlock Text="중국 카트라이더 화면에서 지정된 번역 영역을 실시간으로 감지하여 번역합니다." Margin="0,6,0,0" Foreground="#4B5563" />
        </StackPanel>
        
        <!-- Main Content Area -->
        <Grid Grid.Row="1" Margin="0,20,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="24" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            
            <!-- Left Panel: TabControl for Settings, Dict, Logs -->
            <TabControl Grid.Column="0">
                <!-- Tab 1: General & Style Settings -->
                <TabItem Header="기본 및 스타일">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="0,10,12,0">
                            <!-- Card 1: Basic Target Settings -->
                            <Border Background="#FFFFFF" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="기본 설정" FontSize="15" FontWeight="Bold" Foreground="#111827" Margin="0,0,0,12" />

                                    <TextBlock Text="번역 모드" FontWeight="SemiBold" Foreground="#374151" FontSize="12" />
                                    <Grid Margin="0,6,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="12" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <RadioButton x:Name="ChatTranslationRadioButton" Grid.Column="0" Content="채팅 번역" GroupName="TranslationMode" IsChecked="True" Checked="TranslationModeChanged" MinHeight="30" VerticalContentAlignment="Center" FontWeight="SemiBold" />
                                        <RadioButton x:Name="ScreenTranslationRadioButton" Grid.Column="2" Content="전체화면 번역" GroupName="TranslationMode" Checked="TranslationModeChanged" MinHeight="30" VerticalContentAlignment="Center" FontWeight="SemiBold" />
                                    </Grid>

                                    <TextBlock Text="번역 표시 방법" FontWeight="SemiBold" Foreground="#374151" FontSize="12" />
                                    <ComboBox x:Name="DisplayModeComboBox" Margin="0,6,0,14" MinHeight="34" SelectionChanged="DisplayModeSelectionChanged" />

                                    <TextBlock Text="게임 창 선택" FontWeight="SemiBold" Foreground="#374151" FontSize="12" />
                                    <Grid Margin="0,6,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <ComboBox x:Name="WindowComboBox" MinHeight="34" SelectionChanged="WindowSelectionChanged" />
                                        <Button Grid.Column="1" Width="88" Margin="8,0,0,0" Content="새로고침" Click="RefreshWindows" />
                                    </Grid>

                                    <TextBlock Text="번역 대상 영역" FontWeight="SemiBold" Foreground="#374151" FontSize="12" />
                                    <Grid Margin="0,6,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Button x:Name="SelectRegionButton" Width="120" Height="34" Content="영역 편집" Click="SelectRegion" IsEnabled="True" />
                                        <Button x:Name="ClearRegionButton" Grid.Column="1" Width="64" Height="34" Margin="8,0,0,0" Content="해제" Click="ClearRegion" />
                                        <TextBlock x:Name="RegionText" Grid.Column="2" Margin="12,8,0,0" Text="선택되지 않음" TextWrapping="Wrap" Foreground="#4B5563" FontWeight="Medium" />
                                    </Grid>

                                    <TextBlock Text="OCR 엔진" FontWeight="SemiBold" Foreground="#374151" FontSize="12" />
                                    <ComboBox x:Name="OcrEngineComboBox" Margin="0,6,0,12" MinHeight="34" SelectionChanged="OcrEngineSelectionChanged" />
                                    
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="12" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="OCR 언어" FontWeight="SemiBold" Foreground="#374151" FontSize="12" />
                                            <ComboBox x:Name="OcrLanguageComboBox" Margin="0,6,0,0" MinHeight="34" SelectionChanged="OcrLanguageSelectionChanged" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="번역 언어" FontWeight="SemiBold" Foreground="#374151" FontSize="12" />
                                            <ComboBox x:Name="TargetLanguageComboBox" Margin="0,6,0,0" MinHeight="34" SelectionChanged="TargetLanguageSelectionChanged" />
                                        </StackPanel>
                                    </Grid>
                                    
                                    <CheckBox x:Name="ShowOverlayInScreenShareCheckBox" Content="화면 공유/방송 시 오버레이 표시 (캡처 시 깜빡임 발생)" Checked="ShowOverlayInScreenShareChanged" Unchecked="ShowOverlayInScreenShareChanged" Margin="0,10,0,0" FontWeight="SemiBold" Foreground="#374151" />

                                    <TextBlock Text="오버레이 가독성 프리셋" FontWeight="SemiBold" Foreground="#374151" FontSize="12" Margin="0,12,0,0" />
                                    <ComboBox x:Name="OverlayPresetComboBox" Margin="0,6,0,0" MinHeight="34" SelectionChanged="OverlayPresetSelectionChanged" />

                                    <Grid Margin="0,12,0,0">
                                        <TextBlock Text="오버레이 투명도" FontWeight="SemiBold" Foreground="#374151" FontSize="12" HorizontalAlignment="Left" />
                                        <TextBlock x:Name="OverlayOpacityLabel" Text="92%" FontWeight="SemiBold" Foreground="#2563EB" FontSize="12" HorizontalAlignment="Right" />
                                    </Grid>
                                    <Slider x:Name="OverlayOpacitySlider" Minimum="0.25" Maximum="1" Value="0.92" TickFrequency="0.01" Margin="0,6,0,0" ValueChanged="OverlayOpacitySlider_ValueChanged" />

                                    <Grid Margin="0,12,0,0">
                                        <TextBlock Text="번역 유지시간" FontWeight="SemiBold" Foreground="#374151" FontSize="12" HorizontalAlignment="Left" />
                                        <TextBlock x:Name="OverlayDurationLabel" Text="4초" FontWeight="SemiBold" Foreground="#2563EB" FontSize="12" HorizontalAlignment="Right" />
                                    </Grid>
                                    <Slider x:Name="OverlayDurationSlider" Minimum="1" Maximum="15" Value="4" TickFrequency="1" IsSnapToTickEnabled="True" Margin="0,6,0,0" ValueChanged="OverlayDurationSlider_ValueChanged" />
                                </StackPanel>
                            </Border>

                            <!-- Card 2: Overlay Font and Style Customization -->
                            <Border Background="#FFFFFF" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="오버레이 폰트 설정" FontSize="15" FontWeight="Bold" Foreground="#111827" Margin="0,0,0,12" />
                                    
                                    <TextBlock Text="글꼴" FontWeight="SemiBold" Foreground="#374151" FontSize="12" Margin="0,0,0,6" />
                                    <ComboBox x:Name="FontFamilyComboBox" MinHeight="34" Margin="0,0,0,12" SelectionChanged="FontFamilySelectionChanged" />
                                    
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="12" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <!-- Font Size Slider -->
                                        <StackPanel Grid.Column="0">
                                            <Grid>
                                                <TextBlock Text="글꼴 크기" FontWeight="SemiBold" Foreground="#374151" FontSize="12" HorizontalAlignment="Left" />
                                                <TextBlock x:Name="FontSizeLabel" Text="20pt" FontWeight="SemiBold" Foreground="#2563EB" FontSize="12" HorizontalAlignment="Right" />
                                            </Grid>
                                            <Slider x:Name="FontSizeSlider" Minimum="12" Maximum="48" IsSnapToTickEnabled="True" TickFrequency="1" Margin="0,6,0,0" ValueChanged="FontSizeSlider_ValueChanged" />
                                        </StackPanel>
                                        
                                        <!-- Stroke Thickness Slider -->
                                        <StackPanel Grid.Column="2">
                                            <Grid>
                                                <TextBlock Text="테두리 두께" FontWeight="SemiBold" Foreground="#374151" FontSize="12" HorizontalAlignment="Left" />
                                                <TextBlock x:Name="StrokeThicknessLabel" Text="0.5px" FontWeight="SemiBold" Foreground="#2563EB" FontSize="12" HorizontalAlignment="Right" />
                                            </Grid>
                                            <Slider x:Name="StrokeThicknessSlider" Minimum="0" Maximum="1" TickFrequency="0.1" IsSnapToTickEnabled="False" Margin="0,6,0,0" ValueChanged="StrokeThicknessSlider_ValueChanged" />
                                        </StackPanel>
                                    </Grid>

                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="12" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <!-- Text Color Swatches -->
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="글자 색" FontWeight="SemiBold" Foreground="#374151" FontSize="12" Margin="0,0,0,6" />
                                            <ListBox x:Name="TextColorListBox" ItemContainerStyle="{StaticResource ColorSwatchItemStyle}" BorderThickness="0" Background="Transparent" SelectionChanged="TextColorSelectionChanged" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled">
                                                <ListBox.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel Orientation="Horizontal" />
                                                    </ItemsPanelTemplate>
                                                </ListBox.ItemsPanel>
                                                <ListBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <Ellipse Width="20" Height="20" Fill="{Binding HexBrush}" ToolTip="{Binding Name}" Cursor="Hand" Margin="2" />
                                                    </DataTemplate>
                                                </ListBox.ItemTemplate>
                                            </ListBox>
                                        </StackPanel>
                                        
                                        <!-- Outline Color Swatches -->
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="테두리 색" FontWeight="SemiBold" Foreground="#374151" FontSize="12" Margin="0,0,0,6" />
                                            <ListBox x:Name="OutlineColorListBox" ItemContainerStyle="{StaticResource ColorSwatchItemStyle}" BorderThickness="0" Background="Transparent" SelectionChanged="OutlineColorSelectionChanged" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled">
                                                <ListBox.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel Orientation="Horizontal" />
                                                    </ItemsPanelTemplate>
                                                </ListBox.ItemsPanel>
                                                <ListBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <Ellipse Width="20" Height="20" Fill="{Binding HexBrush}" ToolTip="{Binding Name}" Cursor="Hand" Margin="2" />
                                                    </DataTemplate>
                                                </ListBox.ItemTemplate>
                                            </ListBox>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Background Color and Opacity Controls -->
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="12" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <!-- Background Color Swatches -->
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="배경 색" FontWeight="SemiBold" Foreground="#374151" FontSize="12" Margin="0,0,0,6" />
                                            <ListBox x:Name="BackgroundColorsListBox" ItemContainerStyle="{StaticResource ColorSwatchItemStyle}" BorderThickness="0" Background="Transparent" SelectionChanged="BackgroundColorSelectionChanged" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled">
                                                <ListBox.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel Orientation="Horizontal" />
                                                    </ItemsPanelTemplate>
                                                </ListBox.ItemsPanel>
                                                <ListBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <Ellipse Width="20" Height="20" Fill="{Binding HexBrush}" ToolTip="{Binding Name}" Cursor="Hand" Margin="2" />
                                                    </DataTemplate>
                                                </ListBox.ItemTemplate>
                                            </ListBox>
                                        </StackPanel>
                                        
                                        <!-- Background Opacity Slider -->
                                        <StackPanel Grid.Column="2">
                                            <Grid>
                                                <TextBlock Text="배경 투명도" FontWeight="SemiBold" Foreground="#374151" FontSize="12" HorizontalAlignment="Left" />
                                                <TextBlock x:Name="BackgroundOpacityLabel" Text="60%" FontWeight="SemiBold" Foreground="#2563EB" FontSize="12" HorizontalAlignment="Right" />
                                            </Grid>
                                            <Slider x:Name="BackgroundOpacitySlider" Minimum="0" Maximum="1" TickFrequency="0.01" IsSnapToTickEnabled="False" Margin="0,6,0,0" ValueChanged="BackgroundOpacitySlider_ValueChanged" />
                                        </StackPanel>
                                    </Grid>

                                    <TextBlock Text="폰트 예시 미리보기" FontWeight="SemiBold" Foreground="#374151" FontSize="12" Margin="0,0,0,6" />
                                    <Border Background="#FFFFFF" BorderBrush="#D1D5DB" BorderThickness="1" CornerRadius="5" Height="60" SnapsToDevicePixels="True">
                                        <Grid VerticalAlignment="Center" HorizontalAlignment="Center">
                                            <Border x:Name="FontPreviewBgBorder" CornerRadius="4" Padding="6,4">
                                                <local:OutlinedTextBlock x:Name="FontPreviewTextBlock" Text="즐카~" FontWeight="Bold" />
                                            </Border>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!-- Card 3: DeepL Key Settings -->
                            <Border Background="#FFFFFF" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="번역 API 설정" FontSize="15" FontWeight="Bold" Foreground="#111827" Margin="0,0,0,12" />

                                    <!-- Translator Selection -->
                                    <TextBlock Text="번역 서비스 선택" FontWeight="SemiBold" Foreground="#374151" FontSize="12" Margin="0,0,0,6" />
                                    <ComboBox x:Name="TranslatorTypeComboBox" Margin="0,0,0,12" SelectionChanged="TranslatorTypeComboBox_SelectionChanged">
                                        <ComboBoxItem Content="DeepL API (추천/개인 키 필요)" Tag="DeepL" />
                                        <ComboBoxItem Content="Google 번역 (무료/비공식 API)" Tag="GoogleUnofficial" />
                                        <ComboBoxItem Content="Google Apps Script (무료/개인 웹앱)" Tag="GoogleWebApp" />
                                    </ComboBox>

                                    <!-- DeepL Panel -->
                                    <StackPanel x:Name="DeepLSettingsPanel" Visibility="Visible">
                                    
                                    <!-- API Key Title and Link -->
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="DeepL API Free 인증 키" FontWeight="SemiBold" Foreground="#374151" FontSize="12" VerticalAlignment="Center" />
                                        <Button Grid.Column="1" Content="API 키 발급받기 ↗" Click="OpenDeepLApiKeysPage" Background="Transparent" Foreground="#2563EB" BorderThickness="0" Cursor="Hand" Padding="0" FontWeight="SemiBold" FontSize="11" Focusable="False">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <ContentPresenter />
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </Grid>

                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <PasswordBox x:Name="ApiKeyPasswordBox" MinHeight="34" />
                                        <Button Grid.Column="1" Width="64" Margin="8,0,0,0" Content="저장" Click="SaveApiKey" />
                                        <Button Grid.Column="2" Width="64" Margin="8,0,0,0" Content="삭제" Click="DeleteApiKey" />
                                    </Grid>
                                    <TextBlock Text="인증 키는 로컬 PC에 안전하게 암호화되어 저장됩니다." Foreground="#6B7280" FontSize="11" TextWrapping="Wrap" />
                                    </StackPanel>

                                    <!-- Google Unofficial Panel -->
                                    <StackPanel x:Name="GoogleUnofficialSettingsPanel" Visibility="Collapsed">
                                        <Border Background="#F3F4F6" CornerRadius="6" Padding="12" Margin="0,0,0,8">
                                            <TextBlock Text="API 키 등록 없이 사용할 수 있는 비공식 구글 번역 서비스입니다.&#x0a;일정량 이상의 번역 요청 시 구글에 의해 일시적으로 제한(HTTP 429)될 수 있습니다." 
                                                       Foreground="#4B5563" FontSize="11" TextWrapping="Wrap" LineHeight="16" />
                                        </Border>
                                    </StackPanel>

                                    <!-- Google Web App Panel -->
                                    <StackPanel x:Name="GoogleWebAppSettingsPanel" Visibility="Collapsed">
                                        <TextBlock Text="Google Apps Script 웹 앱 URL" FontWeight="SemiBold" Foreground="#374151" FontSize="12" Margin="0,0,0,6" />
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBox x:Name="GoogleWebAppUrlTextBox" MinHeight="34" VerticalContentAlignment="Center" Padding="6,0" />
                                            <Button Grid.Column="1" Width="64" Margin="8,0,0,0" Content="저장" Click="SaveGoogleWebAppUrl" />
                                        </Grid>
                                        <TextBlock Text="개인 구글 드라이브에 Apps Script 웹 앱을 배포한 후 웹 앱 URL을 입력해 주세요." Foreground="#6B7280" FontSize="11" TextWrapping="Wrap" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- Tab 2: User Dictionary CRUD -->
                <TabItem Header="유저 사전">
                    <Grid Margin="0,10,12,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Dictionary DataGrid -->
                        <DataGrid x:Name="UserDictionaryDataGrid" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" SelectionMode="Single" BorderThickness="1" HeadersVisibility="Column" Background="White">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="분류" Binding="{Binding Category}" Width="110" />
                                <DataGridTextColumn Header="원문 단어 (중국어)" Binding="{Binding Source}" Width="*" />
                                <DataGridTextColumn Header="대체 번역어 (한국어)" Binding="{Binding Target}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>

                        <!-- Add/Delete Form -->
                        <StackPanel Grid.Row="1" Margin="0,12,0,16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="130" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="분류" FontWeight="SemiBold" Foreground="#374151" FontSize="11" Margin="0,0,0,6" />
                                    <ComboBox x:Name="DictCategoryComboBox" Height="30" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="원문 단어" FontWeight="SemiBold" Foreground="#374151" FontSize="11" Margin="0,0,0,6" />
                                    <TextBox x:Name="DictSourceTextBox" Padding="6" Height="30" VerticalContentAlignment="Center" />
                                </StackPanel>
                                <StackPanel Grid.Column="4">
                                    <TextBlock Text="대체 번역어" FontWeight="SemiBold" Foreground="#374151" FontSize="11" Margin="0,0,0,6" />
                                    <TextBox x:Name="DictTargetTextBox" Padding="6" Height="30" VerticalContentAlignment="Center" />
                                </StackPanel>
                            </Grid>

                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Button x:Name="AddDictEntryButton" Height="32" Content="사전 단어 추가" Click="AddDictionaryEntry" Background="#2563EB" Foreground="White" BorderThickness="0" />
                                <Button Grid.Column="2" x:Name="FillDictSourceFromOcrButton" Width="150" Height="32" Content="화면 OCR로 채우기" Click="FillDictionarySourceFromOcr" Background="#7C3AED" Foreground="White" BorderThickness="0" />
                                <Button Grid.Column="4" x:Name="RestoreDefaultsButton" Width="120" Height="32" Content="기본 사전 추가" Click="RestoreDefaultDictionary" Background="#059669" Foreground="White" BorderThickness="0" />
                                <Button Grid.Column="6" x:Name="DeleteDictEntryButton" Width="100" Height="32" Content="선택 삭제" Click="DeleteDictionaryEntry" Background="#EF4444" Foreground="White" BorderThickness="0" />
                            </Grid>
                        </StackPanel>
                    </Grid>
                </TabItem>

                <!-- Tab 3: Real-time Diagnostic Log -->
                <TabItem Header="진단 로그">
                    <Grid Margin="0,10,12,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <DataGrid x:Name="DiagnosticLogsListView"
                                  BorderThickness="1"
                                  Background="White"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  CanUserReorderColumns="True"
                                  CanUserResizeColumns="True"
                                  ClipboardCopyMode="IncludeHeader"
                                  GridLinesVisibility="All"
                                  HeadersVisibility="Column"
                                  IsReadOnly="True"
                                  SelectionMode="Extended"
                                  SelectionUnit="CellOrRowHeader"
                                  ScrollViewer.CanContentScroll="True"
                                  ScrollViewer.HorizontalScrollBarVisibility="Visible"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <DataGrid.Resources>
                                <Style TargetType="{x:Type DataGridCell}">
                                    <Setter Property="Padding" Value="6,4" />
                                    <Setter Property="BorderBrush" Value="#E5E7EB" />
                                    <Setter Property="BorderThickness" Value="0,0,1,1" />
                                </Style>
                                <Style TargetType="{x:Type DataGridColumnHeader}">
                                    <Setter Property="Padding" Value="6,5" />
                                    <Setter Property="Background" Value="#F9FAFB" />
                                    <Setter Property="BorderBrush" Value="#D1D5DB" />
                                    <Setter Property="BorderThickness" Value="0,0,1,1" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                </Style>
                            </DataGrid.Resources>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="시간" Binding="{Binding Time}" Width="80" />
                                <DataGridTextColumn Header="상태" Binding="{Binding Status}" Width="120" />
                                <DataGridTextColumn Header="원문 / 내용" Binding="{Binding Source}" Width="320" />
                                <DataGridTextColumn Header="필터 규칙" Binding="{Binding Rule}" Width="130" />
                                <DataGridTextColumn Header="상세 이유" Binding="{Binding Reason}" Width="260" />
                                <DataGridTextColumn Header="API 사용" Binding="{Binding ApiUsage}" Width="110" />
                            </DataGrid.Columns>
                        </DataGrid>

                        <Grid Grid.Row="1" Margin="0,12,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="※ 최근 100개의 진단 로그만 보관합니다." Foreground="#6B7280" FontSize="11" VerticalAlignment="Center" />
                            <Button Grid.Column="1" Width="100" Height="32" Content="로그 비우기" Click="ClearDiagnosticLogs" />
                        </Grid>

                        <Border Grid.Row="2" Background="#FFFFFF" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="8" Padding="12">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="수동 OCR 텍스트 테스트" FontWeight="SemiBold" Foreground="#374151" FontSize="12" Margin="0,0,0,6" />
                                <Grid Grid.Row="1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="ManualOcrTestTextBox" MinHeight="32" TextWrapping="Wrap" VerticalContentAlignment="Center" ToolTip="예: zuyeong: 快帮我!" />
                                    <Button Grid.Column="1" Width="110" Margin="8,0,0,0" Content="파서 테스트" Click="RunManualOcrParserTest" />
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>
                </TabItem>
            </TabControl>
            
            <!-- Right Panel: Session & Preview -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                
                <!-- Session Control Group -->
                <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="번역 컨트롤" FontSize="15" FontWeight="Bold" Foreground="#111827" />
                        <Grid Margin="0,10,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="번역 상태:" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#4B5563" />
                            <Border Grid.Column="1" Margin="8,0,0,0" CornerRadius="4" Padding="8,6" Background="#F3F4F6">
                                <TextBlock x:Name="StatusText" Text="대기" TextWrapping="Wrap" Foreground="#1F2937" FontWeight="Medium" />
                            </Border>
                        </Grid>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="API 사용량:" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#4B5563" />
                            <TextBlock x:Name="ApiUsageText" Grid.Column="1" Margin="8,0,0,0" Text="이번 세션 0건 / 0자" VerticalAlignment="Center" Foreground="#4B5563" />
                        </Grid>
                        <Border Background="#F9FAFB" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="시작 전 준비" FontSize="12" FontWeight="Bold" Foreground="#374151" Margin="0,0,0,6" />
                                <TextBlock x:Name="ReadyWindowText" TextWrapping="Wrap" FontSize="12" Margin="0,0,0,4" />
                                <TextBlock x:Name="ReadyRegionText" TextWrapping="Wrap" FontSize="12" Margin="0,0,0,4" />
                                <TextBlock x:Name="ReadyOcrText" TextWrapping="Wrap" FontSize="12" Margin="0,0,0,4" />
                                <TextBlock x:Name="ReadyTranslatorText" TextWrapping="Wrap" FontSize="12" Margin="0,0,0,4" />
                                <TextBlock x:Name="ReadyDictionaryText" TextWrapping="Wrap" FontSize="12" />
                            </StackPanel>
                        </Border>
                        <Button x:Name="StartStopButton" Height="40" Content="번역 시작" Click="ToggleSession" FontSize="14" FontWeight="Bold" Background="#2563EB" Foreground="White" BorderThickness="0" />
                    </StackPanel>
                </Border>
                
                <!-- Interactive Preview Panel -->
                <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="8" Padding="14" ClipToBounds="True">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="선택한 번역 방식 예시 미리보기" FontSize="13" FontWeight="Bold" Foreground="#374151" Margin="0,0,0,10" />
                        
                        <Grid Grid.Row="1" ClipToBounds="True">
                            <!-- Preview 1: Separate Result Window Mode -->
                            <Grid x:Name="ResultWindowPreviewGrid" Visibility="Collapsed">
                                <Image Source="pack://application:,,,/Assets/game_screen_result.png" Stretch="Uniform" VerticalAlignment="Center" HorizontalAlignment="Center" />
                            </Grid>
                            
                            <!-- Preview 2: Transparent Overlay Mode -->
                            <Grid x:Name="OverlayPreviewGrid" Visibility="Collapsed">
                                <Image Source="pack://application:,,,/Assets/game_screen_start.jpg" Stretch="Uniform" VerticalAlignment="Center" HorizontalAlignment="Center" />
                            </Grid>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
        
        <!-- Footer / Shortcuts -->
        <TextBlock Grid.Row="2" Foreground="#6B7280" FontSize="12" Text="독점 전체화면 게임(Exclusive Fullscreen)은 창모드(Windowed) 전환이 필요합니다." HorizontalAlignment="Center" />
    </Grid>
</Window>
