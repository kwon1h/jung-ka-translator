<Window x:Class="GameOverlayTranslator.App.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:GameOverlayTranslator.App"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True">
    <Grid>
        <ItemsControl x:Name="OverlayItems" VerticalAlignment="Bottom" Margin="4">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Grid Height="28" Margin="0,0,0,2">
                        <local:OutlinedTextBlock Text="{Binding DisplayText}" FontSize="20" FontWeight="Bold" />
                    </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Grid>
</Window>
