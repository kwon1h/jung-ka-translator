<Window x:Class="GameOverlayTranslator.App.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:GameOverlayTranslator.App"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent"
        BorderThickness="0" ShowInTaskbar="False" Topmost="True" ShowActivated="False">
    <Grid>
        <Path x:Name="ChatBackgroundPath"
              Fill="{Binding Path=OverlayBackgroundBrush, RelativeSource={RelativeSource AncestorType=Window}}"
              IsHitTestVisible="False" />
        <ItemsControl x:Name="OverlayItems" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <Canvas />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemContainerStyle>
                <Style TargetType="ContentPresenter">
                    <Setter Property="Canvas.Left" Value="{Binding Left}" />
                    <Setter Property="Canvas.Top" Value="{Binding Top}" />
                </Style>
            </ItemsControl.ItemContainerStyle>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Border Background="Transparent"
                                CornerRadius="3" Padding="6,0" HorizontalAlignment="Left" ClipToBounds="True"
                                Width="{Binding RenderedWidth}" Height="{Binding Height}"
                                MinWidth="{Binding MinWidth}" MaxWidth="{Binding MaxWidth}">
                            <local:OutlinedTextBlock Text="{Binding DisplayText}" 
                                                     FontFamily="{Binding Path=FontFamily, RelativeSource={RelativeSource AncestorType=Window}}" 
                                                     FontSize="{Binding RenderedFontSize}"
                                                     MaxLineCount="1"
                                                     Fill="{Binding Path=Foreground, RelativeSource={RelativeSource AncestorType=Window}}" 
                                                     Stroke="{Binding Path=StrokeBrush, RelativeSource={RelativeSource AncestorType=Window}}" 
                                                     StrokeThickness="{Binding Path=StrokeThicknessValue, RelativeSource={RelativeSource AncestorType=Window}}" 
                                                     FontWeight="Bold" />
                        </Border>
                    </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        
        <Canvas x:Name="ScreenOverlayCanvas1" Background="Transparent" Visibility="Collapsed" />
        <Canvas x:Name="ScreenOverlayCanvas2" Background="Transparent" Visibility="Collapsed" />
    </Grid>
</Window>
